    "setup-bot": "node scripts/setup-bot.mjs",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "devDependencies": {
    "miniflare": "4.20260426.0",
    "vite": "^6.4.5",
    "wrangler": "4.86.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@vladmandic/human": "^3.3.6",
    "idb-keyval": "^6.3.0",
    "photoswipe": "^5.4.4"
  }
}
